# Online Banking System — Environment Variables Template
# Copy to .env (never commit real secrets)

# ASP.NET Core / Monolith API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# PostgreSQL (managed cloud DB or local container)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=online_banking
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=change_me_local_password
ConnectionStrings__Default=Host=localhost;Port=5432;Database=online_banking;Username=banking_user;Password=change_me_local_password

# JWT Authentication (minimum 32 characters for HS256)
Jwt__Issuer=OnlineBanking.Api
Jwt__Audience=OnlineBanking.Web
Jwt__SecretKey=replace_with_at_least_32_char_secret_key_for_local_dev
Jwt__ExpirationMinutes=60

# CORS (Frontend URL)
Cors__AllowedOrigins=http://localhost:5173

# Initial Admin Bootstrap (optional; leave unset unless provisioning an admin from config)
# AdminBootstrap__Email=admin@example.com
# AdminBootstrap__Password=replace_with_strong_admin_password

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1

# RabbitMQ (Lab 2+)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
