{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "OnlineBanking.Api",
    "Audience": "OnlineBanking.Web",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false
  }
}
